{
  "name": "wandermap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:generate": "npx supabase gen types typescript --local > src/types/database.types.ts",
    "db:migrate": "npx supabase db push",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "api:dev": "npm --prefix backend run dev",
    "api:build": "npm --prefix backend run build",
    "api:type-check": "npm --prefix backend run type-check",
    "api:test": "npm --prefix backend test",
    "api:lint": "npm --prefix backend run lint",
    "api:db:migrate": "npm --prefix backend run db:migrate",
    "api:db:migrate:status": "npm --prefix backend run db:migrate:status"
  },
  "dependencies": {
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@supabase/supabase-js": "^2.47.0",
    "@supabase/ssr": "^0.5.2",
    "react-map-gl": "^7.1.7",
    "mapbox-gl": "^3.8.0",
    "supercluster": "^8.0.1",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-query-devtools": "^5.62.7",
    "zustand": "^5.0.2",
    "framer-motion": "^11.15.0",
    "zod": "^3.23.8",
    "react-hook-form": "^7.54.2",
    "@hookform/resolvers": "^3.9.1",
    "date-fns": "^4.1.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5",
    "lucide-react": "^0.468.0",
    "sonner": "^1.7.1",
    "@radix-ui/react-dialog": "^1.1.3",
    "@radix-ui/react-dropdown-menu": "^2.1.3",
    "@radix-ui/react-select": "^2.1.3",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.5",
    "@radix-ui/react-slot": "^1.1.1",
    "next-themes": "^0.4.4",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/mapbox-gl": "^3.4.1",
    "@types/supercluster": "^7.1.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "eslint": "^9",
    "eslint-config-next": "^15.2.4",
    "supabase": "^2.22.6",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9"
  }
}
