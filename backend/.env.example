NODE_ENV=development
PORT=4000
# Use the service name `postgres` when running inside Docker Compose.
DATABASE_URL=postgresql://wandermap:CHANGE_ME@localhost:5432/wandermap
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
DB_POOL_MAX=10
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
LOG_LEVEL=log,warn,error
# Development docs only. Production defaults to disabled; do not expose internal docs casually.
SWAGGER_ENABLED=true
COOKIE_SAME_SITE=lax
# Explicit trusted peer CIDRs only, after verifying the proxy topology. Empty trusts none.
TRUSTED_PROXY_CIDRS=
# Production always verifies TLS, even when blank. URL SSL overrides cannot weaken verification.
# Use require/verify-full and the Node trust store; see deployment docs for Render endpoints.
PGSSLMODE=
# Local managed images use private files, re-encoded to WebP with EXIF stripped.
UPLOAD_DIR=./uploads
# Managed image URLs; production requires the public HTTPS API URL including /api/v1.
PUBLIC_API_URL=http://localhost:4000/api/v1
STORAGE_PROVIDER=local
# Legacy /uploads is development-only, never used for new managed images.
SERVE_LEGACY_UPLOADS=true
# Legacy configuration only; new uploads always use PUBLIC_API_URL/media/:id.
UPLOAD_PUBLIC_URL=
# Place search (OpenStreetMap data via Photon). The public instance is fair-use only: self-host Photon for production.
PHOTON_URL=https://photon.komoot.io
PLACES_USER_AGENT=WanderMap/1.0 (place search)
# Backend only. Required when STORAGE_PROVIDER=cloudinary (mandatory in production).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
