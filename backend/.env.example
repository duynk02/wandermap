NODE_ENV=development
PORT=4000
# Use the service name `postgres` when running inside Docker Compose.
DATABASE_URL=postgresql://wandermap-onlydev:pass@localhost:5432/wandermap
POSTGRES_PORT=
POSTGRES_PASSWORD=
DB_POOL_MAX=
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_DAYS=
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
COOKIE_SECURE=false
LOG_LEVEL=
COOKIE_SAME_SITE=
#UPLOAD PHOTON
#Image uploads. Files are stored on local disk (re-encoded to WebP, EXIF stripped).
UPLOAD_DIR=./uploads
# Public base URL the browser uses to load images (no trailing slash). Defaults to http://localhost:<PORT>/uploads.
UPLOAD_PUBLIC_URL=
# Place search (OpenStreetMap data via Photon). The public instance is fair-use only: self-host Photon for production.
PHOTON_URL=http://photon.komoot.io
PLACES_USER_AGENT=WanderMap/1.0 (n)