NODE_ENV=development
PORT=4000
# Use the service name `postgres` when running inside Docker Compose.
DATABASE_URL=postgresql://wandermap:wandermap_dev_only@localhost:5432/wandermap
DB_POOL_MAX=10
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
LOG_LEVEL=log
COOKIE_SAME_SITE=lax
