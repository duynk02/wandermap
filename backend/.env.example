NODE_ENV=development
PORT=4000
# Use the service name `postgres` when running inside Docker Compose.
DATABASE_URL=postgresql://wandermap:wandermap_dev_only@localhost:5432/wandermap
DB_POOL_MAX=10
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
LOG_LEVEL=log
COOKIE_SAME_SITE=lax

# Image uploads. Files are stored on local disk (re-encoded to WebP, EXIF stripped).
# UPLOAD_DIR=./uploads
# Public base URL the browser uses to load images (no trailing slash). Defaults to http://localhost:<PORT>/uploads.
# UPLOAD_PUBLIC_URL=http://localhost:4000/uploads

# Place search (OpenStreetMap data via Photon). The public instance is fair-use only: self-host Photon for production.
# PHOTON_URL=https://photon.komoot.io
# PLACES_USER_AGENT=WanderMap/1.0 (contact@example.com)
