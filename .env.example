# ─────────────────────────────────────────
#  WanderMap — Environment Variables
#  Copy this file to .env.local and fill in values
#  NEVER commit .env.local to git
# ─────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Server-side only, never expose!

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=WanderMap

# Optional: OpenWeather (Phase 4)
OPENWEATHER_API_KEY=your-openweather-key

# Optional: Cloudinary (if not using Supabase Storage)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
