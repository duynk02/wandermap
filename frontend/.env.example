# ─────────────────────────────────────────
#  WanderMap — Environment Variables
#  Copy this file to .env.local and fill in values
#  NEVER commit .env.local to git
# ─────────────────────────────────────────

# API (NestJS backend in ./backend)
# Base URL the BROWSER calls. "/api/v1" goes through the Next.js rewrite (same-origin, no CORS).
# An absolute URL also works but then the API's CORS_ORIGINS must include this app's origin.
NEXT_PUBLIC_API_URL=/api/v1
# Server-side only (SSR + rewrite target), full base URL including /api/v1. Never exposed to the browser.
API_INTERNAL_URL=http://localhost:4000/api/v1

# Socket.IO connects directly to NestJS (without /api/v1 or /realtime).
# Use the public HTTPS API origin in production; allow this web app in backend CORS_ORIGINS.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=WanderMap

# Optional: OpenWeather (Phase 4)
OPENWEATHER_API_KEY=your-openweather-key

# Optional: Cloudinary (image storage, not wired yet)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
